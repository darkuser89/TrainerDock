// SPDX-License-Identifier: GPL-3.0-only
// One stable external build tree, shared by Xcode and the command-line entrypoint.
TRAINERDOCK_BUILD_ROOT = $(HOME)/Library/Developer/TrainerDock
SYMROOT = $(TRAINERDOCK_BUILD_ROOT)/Xcode/Build/Products
OBJROOT = $(TRAINERDOCK_BUILD_ROOT)/Xcode/Build/Intermediates.noindex
SHARED_PRECOMPS_DIR = $(TRAINERDOCK_BUILD_ROOT)/Xcode/Build/PrecompiledHeaders
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LANGUAGE_STANDARD = c++17
GCC_OPTIMIZATION_LEVEL = 1
GCC_TREAT_WARNINGS_AS_ERRORS = YES
WARNING_CFLAGS = -Wall -Wextra -Werror
OTHER_CFLAGS = $(inherited) -ffile-prefix-map=$(SRCROOT)=.
GCC_PRECOMPILE_PREFIX_HEADER = NO
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_DEBUG_DYLIB = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
CLANG_ENABLE_MODULES = NO
GCC_NO_COMMON_BLOCKS = YES
ALWAYS_SEARCH_USER_PATHS = NO
USE_HEADERMAP = NO
ENABLE_APP_SANDBOX = NO
